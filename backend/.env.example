# 애플리케이션
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# 외부 API
# 공공데이터포털 Decoding 인증키 권장
# 기상청 단기예보 조회서비스
KMA_API_KEY=
# Optional separate key. If empty, KMA_API_KEY is reused for ASOS.
KMA_ASOS_API_KEY=
# ASOS station used for model weather features (Seoul: 108)
KMA_ASOS_STATION_ID=108
# 기상청 영향예보 조회서비스
KMA_IMPACT_API_KEY=
# 기상청 생활기상지수 조회서비스
KMA_LIVING_INDEX_API_KEY=
# TMAP AppKey (보행자 경로안내 API 사용 권한 필요)
MAP_API_KEY=
PUBLIC_SHELTER_API_KEY=
PUBLIC_SHELTER_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-10942
COOLING_SPOT_SEARCH_RADIUS_METERS=2000

# MySQL
MYSQL_DATABASE=comma
MYSQL_USER=comma
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+asyncmy://comma:change-me@127.0.0.1:3307/comma?charset=utf8mb4
# Optional path to the trained risk classifier. Defaults to artifacts/risk-model/risk_classifier.joblib.
RISK_MODEL_PATH=artifacts/risk-model/risk_classifier.joblib
WORK_LIMIT_MODEL_PATH=artifacts/risk-model-asos/work_limit_classifier.joblib
REST_DECISION_AI_URL=
REST_DECISION_AI_API_KEY=
REST_DECISION_AI_TIMEOUT_SECONDS=10
REST_DECISION_HIGH_SCORE_THRESHOLD=85
REST_DECISION_LOW_SCORE_THRESHOLD=20
